<script type="text/javascript"><!--
// ApiShip: поиск ПВЗ в модалке выбора способа доставки при редактировании заказа
(function() {
    var timer = null;

    function apiship_render_methods(json) {
        var html = '';
        var k = 1000;

        if (typeof json['error'] == 'string') {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }

        if (json['shipping_methods']) {
            for (var i in json['shipping_methods']) {
                html += '<p><strong>' + json['shipping_methods'][i]['name'] + '</strong></p>';

                if (!json['shipping_methods'][i]['error']) {
                    for (var j in json['shipping_methods'][i]['quote']) {
                        if (typeof shipping_method !== 'undefined') {
                            shipping_method[json['shipping_methods'][i]['quote'][j]['code']] = json['shipping_methods'][i]['quote'][j];
                        }

                        html += '<div class="form-check">';
                        html += '  <input type="radio" name="choose_shipping" value="' + json['shipping_methods'][i]['quote'][j]['code'] + '" id="input-shipping-method-' + k + '"';

                        if (json['shipping_methods'][i]['quote'][j]['code'] == $('#input-shipping-method-code').val()) {
                            html += ' checked';
                        }

                        html += '/>';
                        html += '  <label for="input-shipping-method-' + k + '">' + json['shipping_methods'][i]['quote'][j]['name'] + ' - ' + json['shipping_methods'][i]['quote'][j]['text'] + '</label>';
                        html += '</div>';

                        k++;
                    }
                } else {
                    html += '<div class="alert alert-danger">' + json['shipping_methods'][i]['error'] + '</div>';
                }
            }
        }

        $('#shipping-methods').find('.form-check, p, .alert').remove();
        $('#shipping-methods').append(html);
    }

    function apiship_search(term) {
        $.ajax({
            url: 'index.php?route=sale/order.call&user_token={{ user_token }}&call=shipping_methods&store_id=' + $('#input-store').val() + '&language=' + $('#input-language').val() + '&currency=' + $('#input-currency').val() + '&term=' + encodeURIComponent(term),
            type: 'post',
            data: $('#form-customer, #form-cart, #form-shipping-address, #form-shipping-method, #form-payment-address, #form-payment-method, #collapse-order form').serialize(),
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            success: function(json) {
                apiship_render_methods(json);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }

    $('#modal-shipping-method').on('shown.bs.modal', function() {
        if (!$('#shipping-methods input[value^=\'apiship.\']').length) {
            return;
        }

        if ($('#apiship-shipping-search').length) {
            return;
        }

        $('#shipping-methods').prepend('<div class="input-group mb-3"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span><input type="text" id="apiship-shipping-search" class="form-control" placeholder="{{ text_apiship_search_method|escape('js') }}"/></div>');

        $('#apiship-shipping-search').on('input', function() {
            var term = $(this).val();

            clearTimeout(timer);

            timer = setTimeout(function() {
                apiship_search(term);
            }, 400);
        });
    });
})();
//--></script>
