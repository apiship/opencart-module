{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-apiship" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning|escape }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-apiship" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="shipping_apiship_version_js_mod" value="{{ shipping_apiship_version_js_mod }}"/>
          <div class="mb-3"><img src="../extension/apiship/admin/view/image/apiship.png" alt="ApiShip" title="ApiShip"/></div>
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-main" data-bs-toggle="tab" class="nav-link active">{{ tab_main_settings }}</a></li>
            <li class="nav-item"><a href="#tab-providers" data-bs-toggle="tab" class="nav-link">{{ tab_providers_points }}</a></li>
            <li class="nav-item"><a href="#tab-mapping" data-bs-toggle="tab" class="nav-link">{{ tab_events_mapping }}</a></li>
            <li class="nav-item"><a href="#tab-cod" data-bs-toggle="tab" class="nav-link">{{ tab_cash_on_delivery }}</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-main" class="tab-pane active">
              <div class="row mb-3 required">
                <label for="input-rub-select" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_rub_select }}</label>
                <div class="col-sm-9">
                  <select name="shipping_apiship_rub_select" id="input-rub-select" class="form-select">
                    <option value=""></option>
                    {% for currency in currencies %}
                      <option value="{{ currency.code }}"{% if currency.code == shipping_apiship_rub_select %} selected{% endif %}>{{ currency.code }}</option>
                    {% endfor %}
                  </select>
                  <div id="error-rub-select" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-gr-select" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_gr_select }}</label>
                <div class="col-sm-9">
                  <select name="shipping_apiship_gr_select" id="input-gr-select" class="form-select">
                    <option value=""></option>
                    {% for weight_class in weight_classes %}
                      <option value="{{ weight_class.weight_class_id }}"{% if weight_class.weight_class_id == shipping_apiship_gr_select %} selected{% endif %}>{{ weight_class.title }}</option>
                    {% endfor %}
                  </select>
                  <div id="error-gr-select" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-cm-select" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_cm_select }}</label>
                <div class="col-sm-9">
                  <select name="shipping_apiship_cm_select" id="input-cm-select" class="form-select">
                    <option value=""></option>
                    {% for length_class in length_classes %}
                      <option value="{{ length_class.length_class_id }}"{% if length_class.length_class_id == shipping_apiship_cm_select %} selected{% endif %}>{{ length_class.title }}</option>
                    {% endfor %}
                  </select>
                  <div id="error-cm-select" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-token" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_token }}</label>
                <div class="col-sm-9">
                  <input type="text" name="shipping_apiship_token" value="{{ shipping_apiship_token }}" placeholder="{{ entry_shipping_apiship_token }}" id="input-token" class="form-control"/>
                  <div id="error-token" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-title" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_title }}</label>
                <div class="col-sm-9">
                  <input type="text" name="shipping_apiship_title" value="{{ shipping_apiship_title }}" id="input-title" class="form-control"/>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-custom-code" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_custom_code }}</label>
                <div class="col-sm-9">
                  <input type="text" name="shipping_apiship_custom_code" value="{{ shipping_apiship_custom_code }}" id="input-custom-code" class="form-control"/>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_include_fees }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="shipping_apiship_include_fees" value="0"/>
                    <input type="checkbox" name="shipping_apiship_include_fees" value="1" id="input-include-fees" class="form-check-input"{% if shipping_apiship_include_fees %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_group_points }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="shipping_apiship_group_points" value="0"/>
                    <input type="checkbox" name="shipping_apiship_group_points" value="1" id="input-group-points" class="form-check-input"{% if shipping_apiship_group_points %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <fieldset>
                <legend>{{ entry_shipping_apiship_template }}</legend>
                <div class="row mb-3">
                  <label for="input-title-point-template" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_title_point_template }}</label>
                  <div class="col-sm-9">
                    <input type="text" name="shipping_apiship_title_point_template" value="{{ shipping_apiship_title_point_template }}" id="input-title-point-template" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-description-point-template" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_description_point_template }}</label>
                  <div class="col-sm-9">
                    <textarea rows="3" name="shipping_apiship_description_point_template" id="input-description-point-template" class="form-control">{{ shipping_apiship_description_point_template }}</textarea>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-title-door-template" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_title_door_template }}</label>
                  <div class="col-sm-9">
                    <input type="text" name="shipping_apiship_title_door_template" value="{{ shipping_apiship_title_door_template }}" id="input-title-door-template" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-description-door-template" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_description_door_template }}</label>
                  <div class="col-sm-9">
                    <textarea rows="3" name="shipping_apiship_description_door_template" id="input-description-door-template" class="form-control">{{ shipping_apiship_description_door_template }}</textarea>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-sm-9 offset-sm-3">{{ entry_shipping_apiship_template_desc }}</div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_icon_show }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="shipping_apiship_icon_show" value="0"/>
                      <input type="checkbox" name="shipping_apiship_icon_show" value="1" id="input-icon-show" class="form-check-input"{% if shipping_apiship_icon_show %} checked{% endif %}/>
                    </div>
                  </div>
                </div>
              </fieldset>
              <fieldset>
                <legend>{{ entry_sending_address }}</legend>
                <div class="row mb-3 required">
                  <label for="input-sending-country-code" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_sending_country_code }}</label>
                  <div class="col-sm-9">
                    <select name="shipping_apiship_sending_country_code" id="input-sending-country-code" class="form-select">
                      {% for mode in shipping_apiship_countries %}
                        <option value="{{ mode.code }}"{% if mode.code == shipping_apiship_sending_country_code %} selected{% endif %}>{{ mode.code_text }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                {% for field in ['sending_region', 'sending_city', 'sending_street', 'sending_house'] %}
                  <div class="row mb-3 required">
                    <label for="input-{{ field|replace({'_': '-'}) }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}</label>
                    <div class="col-sm-9">
                      <input type="text" name="shipping_apiship_{{ field }}" value="{{ attribute(_context, 'shipping_apiship_' ~ field) }}" placeholder="{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}" id="input-{{ field|replace({'_': '-'}) }}" class="form-control"/>
                      <div id="error-{{ field|replace({'_': '-'}) }}" class="invalid-feedback"></div>
                    </div>
                  </div>
                {% endfor %}
                {% for field in ['sending_block', 'sending_office'] %}
                  <div class="row mb-3">
                    <label for="input-{{ field|replace({'_': '-'}) }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}</label>
                    <div class="col-sm-9">
                      <input type="text" name="shipping_apiship_{{ field }}" value="{{ attribute(_context, 'shipping_apiship_' ~ field) }}" placeholder="{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}" id="input-{{ field|replace({'_': '-'}) }}" class="form-control"/>
                    </div>
                  </div>
                {% endfor %}
              </fieldset>
              <fieldset>
                <legend>{{ entry_contact_details }}</legend>
                {% for field in ['contact_organization', 'contact_inn', 'contact_name', 'contact_phone', 'contact_email'] %}
                  <div class="row mb-3{% if field != 'contact_inn' %} required{% endif %}">
                    <label for="input-{{ field|replace({'_': '-'}) }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}</label>
                    <div class="col-sm-9">
                      <input type="text" name="shipping_apiship_{{ field }}" value="{{ attribute(_context, 'shipping_apiship_' ~ field) }}" placeholder="{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}" id="input-{{ field|replace({'_': '-'}) }}" class="form-control"/>
                      <div id="error-{{ field|replace({'_': '-'}) }}" class="invalid-feedback"></div>
                    </div>
                  </div>
                {% endfor %}
              </fieldset>
              <fieldset>
                <legend>{{ entry_parcel_defaults }}</legend>
                {% for field in ['parcel_length', 'parcel_width', 'parcel_height', 'parcel_weight'] %}
                  <div class="row mb-3 required">
                    <label for="input-{{ field|replace({'_': '-'}) }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}</label>
                    <div class="col-sm-9">
                      <input type="number" name="shipping_apiship_{{ field }}" value="{{ attribute(_context, 'shipping_apiship_' ~ field) }}" id="input-{{ field|replace({'_': '-'}) }}" class="form-control"/>
                      <div id="error-{{ field|replace({'_': '-'}) }}" class="invalid-feedback"></div>
                    </div>
                  </div>
                {% endfor %}
              </fieldset>
              <fieldset>
                <legend>{{ entry_place_defaults }}</legend>
                {% for field in ['place_length', 'place_width', 'place_height', 'place_weight', 'package_weight'] %}
                  <div class="row mb-3">
                    <label for="input-{{ field|replace({'_': '-'}) }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}</label>
                    <div class="col-sm-9">
                      <input type="number" name="shipping_apiship_{{ field }}" value="{{ attribute(_context, 'shipping_apiship_' ~ field) }}" id="input-{{ field|replace({'_': '-'}) }}" class="form-control"/>
                    </div>
                  </div>
                {% endfor %}
              </fieldset>
              <fieldset>
                <legend>{{ entry_extra_settings }}</legend>
                <div class="row mb-3">
                  <label for="input-articul-mode" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_articul_mode }}</label>
                  <div class="col-sm-9">
                    <select name="shipping_apiship_articul_mode" id="input-articul-mode" class="form-select">
                      <option value="0">{{ text_none }}</option>
                      {% for articul_mode in shipping_apiship_articul_modes %}
                        <option value="{{ articul_mode.code }}"{% if articul_mode.code == shipping_apiship_articul_mode %} selected{% endif %}>{{ articul_mode.code_text }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-tax-class" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_tax_class }}</label>
                  <div class="col-sm-9">
                    <select name="shipping_apiship_tax_class_id" id="input-tax-class" class="form-select">
                      <option value="0">{{ text_none }}</option>
                      {% for tax_class in tax_classes %}
                        <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_apiship_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-geo-zone" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_geo_zone }}</label>
                  <div class="col-sm-9">
                    <select name="shipping_apiship_geo_zone_id" id="input-geo-zone" class="form-select">
                      <option value="0">{{ text_all_zones }}</option>
                      {% for geo_zone in geo_zones %}
                        <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_apiship_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-prefix" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_prefix }}</label>
                  <div class="col-sm-9">
                    <input type="text" name="shipping_apiship_prefix" value="{{ shipping_apiship_prefix }}" id="input-prefix" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_error_stub_show }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="shipping_apiship_error_stub_show" value="0"/>
                      <input type="checkbox" name="shipping_apiship_error_stub_show" value="1" id="input-error-stub-show" class="form-check-input"{% if shipping_apiship_error_stub_show %} checked{% endif %}/>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_use_fix_product_assessed_cost }}</label>
                  <div class="col-sm-9">
                    <div class="input-group">
                      <div class="input-group-text">
                        <input type="hidden" name="shipping_apiship_use_fix_product_assessed_cost" value="0"/>
                        <input type="checkbox" name="shipping_apiship_use_fix_product_assessed_cost" value="1" id="input-use-fix-product-assessed-cost" class="form-check-input mt-0"{% if shipping_apiship_use_fix_product_assessed_cost %} checked{% endif %}/>
                      </div>
                      <input type="number" name="shipping_apiship_fix_product_assessed_cost" value="{{ shipping_apiship_fix_product_assessed_cost }}" id="input-fix-product-assessed-cost" class="form-control"/>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-add-pickup-date" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_add_pickup_date }}</label>
                  <div class="col-sm-9">
                    <select name="shipping_apiship_add_pickup_date" id="input-add-pickup-date" class="form-select">
                      {% for mode in shipping_apiship_pickup_dates %}
                        <option value="{{ mode.code }}"{% if mode.code == shipping_apiship_add_pickup_date %} selected{% endif %}>{{ mode.code_text }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                {% for field in ['export_status', 'cancel_export_status', 'group_export_status_ready', 'group_export_status_ok', 'group_export_status_error'] %}
                  <div class="row mb-3 required">
                    <label for="input-{{ field|replace({'_': '-'}) }}" class="col-sm-3 col-form-label">{{ attribute(_context, 'entry_shipping_apiship_' ~ field) }}</label>
                    <div class="col-sm-9">
                      <select name="shipping_apiship_{{ field }}" id="input-{{ field|replace({'_': '-'}) }}" class="form-select">
                        <option value=""></option>
                        {% for order_status in order_statuses %}
                          <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == attribute(_context, 'shipping_apiship_' ~ field) %} selected{% endif %}>{{ order_status.name }}</option>
                        {% endfor %}
                      </select>
                      <div id="error-{{ field|replace({'_': '-'}) }}" class="invalid-feedback"></div>
                    </div>
                  </div>
                {% endfor %}
                <div class="row mb-3">
                  <label for="input-cron-key" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_cron_key }}</label>
                  <div class="col-sm-9">
                    <input type="text" name="shipping_apiship_cron_key" value="{{ shipping_apiship_cron_key }}" id="input-cron-key" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-export-cron-url" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_export_cron_url }}</label>
                  <div class="col-sm-9">
                    <div class="input-group">
                      <input type="text" id="input-export-cron-url" value="{{ shipping_apiship_export_cron_url }}" class="form-control" readonly/>
                      <button type="button" class="btn btn-light apiship-copy" data-target="#input-export-cron-url" title="{{ text_shipping_apiship_cron_url_copy }}"><i class="fa-solid fa-clipboard"></i></button>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-import-cron-url" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_import_cron_url }}</label>
                  <div class="col-sm-9">
                    <div class="input-group">
                      <input type="text" id="input-import-cron-url" value="{{ shipping_apiship_import_cron_url }}" class="form-control" readonly/>
                      <button type="button" class="btn btn-light apiship-copy" data-target="#input-import-cron-url" title="{{ text_shipping_apiship_cron_url_copy }}"><i class="fa-solid fa-clipboard"></i></button>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-cron-example" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_cron_example }}</label>
                  <div class="col-sm-9">
                    <div class="input-group">
                      <input type="text" id="input-cron-example" value="curl -X POST -H &quot;X-Apiship-Key: {{ shipping_apiship_cron_key }}&quot; &quot;{{ shipping_apiship_export_cron_url }}&quot;" class="form-control" readonly/>
                      <button type="button" class="btn btn-light apiship-copy" data-target="#input-cron-example" title="{{ text_shipping_apiship_cron_url_copy }}"><i class="fa-solid fa-clipboard"></i></button>
                    </div>
                    <div class="form-text">{{ help_shipping_apiship_cron }}</div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-yandex-api-key" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_yandex_api_key }}</label>
                  <div class="col-sm-9">
                    <input type="text" name="shipping_apiship_yandex_api_key" value="{{ shipping_apiship_yandex_api_key }}" id="input-yandex-api-key" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-sort-order" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_sort_order }}</label>
                  <div class="col-sm-9">
                    <input type="text" name="shipping_apiship_sort_order" value="{{ shipping_apiship_sort_order }}" id="input-sort-order" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-mode" class="col-sm-3 col-form-label">{{ entry_shipping_apiship_mode }}</label>
                  <div class="col-sm-9">
                    <select name="shipping_apiship_mode" id="input-mode" class="form-select">
                      {% for mode in shipping_apiship_modes %}
                        <option value="{{ mode.code }}"{% if mode.code == shipping_apiship_mode %} selected{% endif %}>{{ mode.code_text }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_status }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="shipping_apiship_status" value="0"/>
                      <input type="checkbox" name="shipping_apiship_status" value="1" id="input-status" class="form-check-input"{% if shipping_apiship_status %} checked{% endif %}/>
                    </div>
                  </div>
                </div>
              </fieldset>
            </div>
            <div id="tab-providers" class="tab-pane">
              {% for provider in shipping_apiship_providers %}
                {% set provider_settings = shipping_apiship_provider[provider.key] ?? {} %}
                {% set provider_point = shipping_apiship_providers_points[provider.key] ?? {} %}
                <fieldset>
                  <legend>{{ provider.name|escape }}</legend>
                  <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">{{ entry_providers_point }}</label>
                    <div class="col-sm-9">
                      <div class="input-group">
                        <div class="input-group-text">
                          <input class="shipping_apiship_provider_point form-check-input mt-0" data-id="{{ provider.key|escape('html_attr') }}" type="checkbox" name="shipping_apiship_provider[{{ provider.key|escape('html_attr') }}][pickup_type]" value="1"{% if provider_settings.pickup_type is defined and provider_settings.pickup_type %} checked{% endif %}/>
                        </div>
                        <select class="shipping_apiship_provider form-select" data-id="{{ provider.key|escape('html_attr') }}" name="shipping_apiship_provider[{{ provider.key|escape('html_attr') }}][id]" id="shipping_apiship_provider_{{ provider.key|escape('html_attr') }}">
                          <option value="{{ (provider_point.id ?? '')|escape('html_attr') }}">{{ (provider_point.address ?? '')|escape }}</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">{{ entry_providers_courier }}</label>
                    <div class="col-sm-9">
                      <div class="form-check form-switch form-switch-lg">
                        <input class="shipping_apiship_provider_courier form-check-input" data-id="{{ provider.key|escape('html_attr') }}" type="checkbox" name="shipping_apiship_provider[{{ provider.key|escape('html_attr') }}][courier_type]" value="1"{% if provider_settings.courier_type is defined and provider_settings.courier_type %} checked{% endif %}/>
                      </div>
                    </div>
                  </div>
                </fieldset>
              {% endfor %}
            </div>
            <div id="tab-mapping" class="tab-pane">
              {% for status in shipping_apiship_integrator_statuses %}
                {% set status_settings = shipping_apiship_mapping_status[status.key] ?? {} %}
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ status.name|escape }}</label>
                  <div class="col-sm-9">
                    <div class="input-group">
                      <div class="input-group-text">
                        <input class="shipping_apiship_mapping_checkbox_use form-check-input mt-0" data-id="{{ status.key|escape('html_attr') }}" type="checkbox" name="shipping_apiship_mapping_status[{{ status.key|escape('html_attr') }}][use]" value="1"{% if status_settings.use is defined and status_settings.use %} checked{% endif %}/>
                      </div>
                      <select name="shipping_apiship_mapping_status[{{ status.key|escape('html_attr') }}][order_status_id]" data-id="{{ status.key|escape('html_attr') }}" id="shipping_apiship_mapping_use_{{ status.key|escape('html_attr') }}" class="form-select">
                        {% for order_status in order_statuses %}
                          <option value="{{ order_status.order_status_id }}"{% if status_settings.order_status_id is defined and order_status.order_status_id == status_settings.order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                        {% endfor %}
                      </select>
                      <span class="input-group-text">{{ entry_events_mapping_notify }}</span>
                      <div class="input-group-text">
                        <input class="shipping_apiship_mapping_checkbox_notify form-check-input mt-0" data-id="{{ status.key|escape('html_attr') }}" type="checkbox" name="shipping_apiship_mapping_status[{{ status.key|escape('html_attr') }}][notify]" id="shipping_apiship_mapping_notify_{{ status.key|escape('html_attr') }}" value="1"{% if status_settings.notify is defined and status_settings.notify %} checked{% endif %}/>
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div id="tab-cod" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_paid_orders }}</label>
                <div class="col-sm-9">
                  <div class="form-control" style="height: 200px; overflow: auto;">
                    {% for order_status in order_statuses %}
                      <div class="form-check">
                        <input type="checkbox" name="shipping_apiship_paid_orders[]" value="{{ order_status.order_status_id }}" id="input-paid-order-{{ order_status.order_status_id }}" class="form-check-input"{% if order_status.order_status_id in shipping_apiship_paid_orders %} checked{% endif %}/>
                        <label for="input-paid-order-{{ order_status.order_status_id }}" class="form-check-label">{{ order_status.name }}</label>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_shipping_apiship_cash_on_delivery_payment_methods }}</label>
                <div class="col-sm-9">
                  <div class="form-control" style="height: 200px; overflow: auto;">
                    {% for payment_method in payment_methods %}
                      <div class="form-check">
                        <input type="checkbox" name="shipping_apiship_cash_on_delivery_payment_methods[]" value="{{ payment_method.code }}" id="input-cod-{{ payment_method.code }}" class="form-check-input"{% if payment_method.code in shipping_apiship_cash_on_delivery_payment_methods %} checked{% endif %}/>
                        <label for="input-cod-{{ payment_method.code }}" class="form-check-label">{{ payment_method.name }}</label>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="text-center text-muted my-3">{{ text_apiship_version }}: {{ shipping_apiship_version }}</div>
  </div>
</div>
<link href="../extension/apiship/admin/view/javascript/select2.min.css" type="text/css" rel="stylesheet" media="screen"/>
<script src="../extension/apiship/admin/view/javascript/select2.full.min.js" type="text/javascript"></script>
<script src="../extension/apiship/admin/view/javascript/i18n/ru.js" type="text/javascript"></script>
<style>
.select2-container { width: 100% !important; flex: 1 1 auto; }
.input-group .select2-container { width: auto !important; }
.input-group .select2-container .select2-selection--single { height: 38px; }
</style>
<script type="text/javascript"><!--
$('.apiship-copy').on('click', function() {
    var input = document.querySelector($(this).data('target'));

    input.select();

    if (navigator.clipboard) {
        navigator.clipboard.writeText(input.value);
    } else {
        document.execCommand('copy');
    }

    return false;
});

$('#input-cron-key').on('input', function() {
    $('#input-cron-example').val('curl -X POST -H "X-Apiship-Key: ' + $(this).val() + '" "{{ shipping_apiship_export_cron_url }}"');
});

$('.shipping_apiship_provider').select2({
    ajax: {
        url: '{{ point_search_url }}',
        data: function(params) {
            return {
                search: params.term,
                type: $(this).attr('data-id')
            };
        },
        dataType: 'json',
        delay: 250,
        processResults: function(data) {
            var results = [];

            $.each(data, function(index, item) {
                results.push({
                    id: item.id,
                    text: item.code + ', ' + item.text
                });
            });

            return {
                results: results
            };
        }
    },
    minimumInputLength: 3,
    placeholder: '{{ text_apiship_search_point|escape('js') }}',
    language: 'ru'
});

function set_providers_checkbox(checked, provider) {
    $('#shipping_apiship_provider_' + provider).prop('disabled', !checked);
}

$('.shipping_apiship_provider_point').on('click', function() {
    set_providers_checkbox(this.checked, $(this).attr('data-id'));
});

$('.shipping_apiship_provider_point').each(function() {
    set_providers_checkbox(this.checked, $(this).attr('data-id'));
});

function set_status_checkbox(checked, status) {
    $('#shipping_apiship_mapping_use_' + status).prop('disabled', !checked);
    $('#shipping_apiship_mapping_notify_' + status).prop('disabled', !checked);
}

$('.shipping_apiship_mapping_checkbox_use').on('click', function() {
    set_status_checkbox(this.checked, $(this).attr('data-id'));
});

$('.shipping_apiship_mapping_checkbox_use').each(function() {
    set_status_checkbox(this.checked, $(this).attr('data-id'));
});

// Отключённые поля не уходят в POST: перед отправкой включаем их, чтобы настройки не терялись
$('#form-apiship').on('submit', function() {
    $(this).find(':disabled').prop('disabled', false);
});
//--></script>
{{ footer }}
